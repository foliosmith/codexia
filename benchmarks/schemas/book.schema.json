{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "language": {
      "enum": [
        "en",
        "zh",
        "mixed"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+\\.xhtml$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "text",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "href",
          "title",
          "paragraphs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "family",
    "language",
    "title",
    "license",
    "chapters"
  ],
  "additionalProperties": false
}
