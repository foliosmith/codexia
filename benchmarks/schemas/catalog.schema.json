{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.0"
    },
    "split": {
      "enum": [
        "dev",
        "holdout"
      ]
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "cases": {
      "type": "string",
      "minLength": 1
    },
    "gold": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "split",
    "books",
    "cases",
    "gold"
  ],
  "additionalProperties": false
}
