{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "required_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "forbidden_conclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence_sets": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
        },
        "minItems": 1
      },
      "minItems": 0
    },
    "answerable": {
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "status",
    "required_points",
    "forbidden_conclusions",
    "evidence_sets",
    "answerable"
  ],
  "additionalProperties": false
}
