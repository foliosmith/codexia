{
  "manifest_version": 3,
  "name": "Codexia Explain Selection",
  "version": "0.1.0",
  "description": "Explain a grounded selection through a local Codexia Book Agent.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": { "default_popup": "popup.html", "default_title": "Codexia" }
}
